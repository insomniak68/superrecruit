# ── SuperRecruit Environment Variables ──

# Anthropic API key (required for skill extraction and workspace agent)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# LLM model to use (backward compatible)
SR_LLM_MODEL=claude-sonnet-4-20250514

# ── LLM Provider Overrides (optional — see config/llm.yaml for full config) ──
# SR_LLM_DEFAULT_PROVIDER=anthropic
# SR_LLM_DEFAULT_MODEL=claude-sonnet-4-20250514
# SR_LLM_SKILL_EXTRACTION_MODEL=claude-sonnet-4-20250514
# SR_LLM_SKILL_EXTRACTION_PROVIDER=anthropic
# SR_LLM_WORKSPACE_CHAT_MODEL=claude-sonnet-4-20250514
# SR_LLM_BULK_PROCESSING_MODEL=claude-sonnet-4-20250514
# SR_LLM_CONFIDENCE_REASONING_MODEL=claude-sonnet-4-20250514

# Database path (SQLite)
SR_DB_PATH=data/superrecruit.db

# Server configuration
SR_HOST=0.0.0.0
SR_PORT=8000
SR_BASE_URL=http://localhost:8000

# SMTP configuration (for sending assessment emails)
SR_SMTP_HOST=
SR_SMTP_PORT=587
SR_SMTP_USER=
SR_SMTP_PASSWORD=
SR_SMTP_FROM=assessments@superrecruit.dev

# Upload directory
SR_UPLOAD_DIR=data/uploads
